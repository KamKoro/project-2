<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>My Lists</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <main id="main-content" class="container mt-6">
    <div class="level mb-5">
      <div class="level-left"><h1 class="title is-2">My Lists</h1></div>
      <div class="level-right"><a href="/lists/new" class="button is-primary">Create List</a></div>
    </div>

    <% if (!lists.length) { %>
      <div class="box has-text-centered">
        <p>No lists yet. Create one to curate your favorite films.</p>
      </div>
    <% } else { %>
      <div class="review-list">
        <% lists.forEach(list => { %>
          <article class="box mb-4">
            <h2 class="title is-4"><a href="/lists/<%= list._id %>"><%= list.name %></a></h2>
            <% if (list.description) { %><p><%= list.description %></p><% } %>
            <p class="has-text-grey"><%= list.films.length %> films · <%= list.isPublic ? 'Public' : 'Private' %></p>
          </article>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>

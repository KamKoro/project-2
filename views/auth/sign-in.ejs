<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign In</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <!-- Navbar -->
  <%- include('../partials/_navbar') %>

  <!-- Main Content -->
  <main id="main-content" class="container mt-6">
    <section class="box" style="max-width: 500px; margin: 0 auto;">
      <h1 class="title is-3 has-text-centered mb-5">Sign In to Your Account</h1>

      <form action="/auth/sign-in" method="POST">
        <div class="field">
          <label class="label" for="username">Username</label>
          <div class="control">
            <input class="input" type="text" name="username" id="username" placeholder="Enter your username" autocomplete="username" required />
          </div>
        </div>

        <%- include('../partials/_passwordField', {
          id: 'password',
          name: 'password',
          label: 'Password',
          placeholder: 'Enter your password',
          autocomplete: 'current-password'
        }) %>

        <!-- Submit Button -->
        <div class="field is-grouped is-justify-content-center mt-4">
          <div class="control">
            <button class="button is-primary" type="submit">Sign In</button>
          </div>
        </div>
      </form>

      <!-- Optional link to Sign Up -->
      <p class="has-text-centered mt-4">
        Don't have an account? <a href="/auth/sign-up">Create one here</a>.
      </p>
    </section>
  </main>
  <script src="/javascripts/password-toggle.js"></script>
</body>
</html>

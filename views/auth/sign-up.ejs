<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sign Up</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <!-- Navbar -->
  <%- include('../partials/_navbar') %>

  <!-- Main Content -->
  <main id="main-content" class="container mt-6">
    <section class="box" style="max-width: 500px; margin: 0 auto;">
      <h1 class="title is-3 has-text-centered mb-5">Create a New Account</h1>

      <% if (error === 'exists') { %>
        <div class="notification is-warning is-light mb-4">That username is already taken. Try another one.</div>
      <% } else if (error === 'mismatch') { %>
        <div class="notification is-danger is-light mb-4">Passwords do not match. Please try again.</div>
      <% } else if (error === 'server') { %>
        <div class="notification is-danger is-light mb-4">Something went wrong. Please try again.</div>
      <% } %>

      <form action="/auth/sign-up" method="POST">
        <div class="field">
          <label class="label" for="username">Username</label>
          <div class="control">
            <input class="input" type="text" id="username" name="username" placeholder="Enter your username" autocomplete="username" required>
          </div>
        </div>

        <%- include('../partials/_passwordField', {
          id: 'password',
          name: 'password',
          label: 'Password',
          placeholder: 'Enter your password',
          autocomplete: 'new-password'
        }) %>

        <%- include('../partials/_passwordField', {
          id: 'confirmPassword',
          name: 'confirmPassword',
          label: 'Confirm Password',
          placeholder: 'Confirm your password',
          autocomplete: 'new-password'
        }) %>

        <!-- Submit Button -->
        <div class="field is-grouped is-justify-content-center mt-4">
          <div class="control">
            <button class="button is-primary" type="submit">Sign Up</button>
          </div>
        </div>
      </form>

      <!-- Optional link to Sign In -->
      <p class="has-text-centered mt-4">
        Already have an account? <a href="/auth/sign-in">Sign in here</a>.
      </p>
    </section>
  </main>
  <script src="/javascripts/password-toggle.js"></script>
</body>
</html>

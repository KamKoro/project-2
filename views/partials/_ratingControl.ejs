<%
  const scoreLabels = {
    1: 'Awful',
    2: 'Bad',
    3: 'Poor',
    4: 'Watchable',
    5: 'Okay',
    6: 'Good',
    7: 'Very Good',
    8: 'Great',
    9: 'Excellent',
    10: 'Masterpiece',
  };
  const currentRating = typeof selectedRating !== 'undefined' ? selectedRating : 0;
  const ratingLabelId = typeof labelId !== 'undefined' ? labelId : 'rating-label';
  const ratingBadgeId = typeof badgeId !== 'undefined' ? badgeId : 'rating-badge';
  const ratingInputId = typeof inputId !== 'undefined' ? inputId : 'rating-value';
  const ratingHeading = typeof heading !== 'undefined' ? heading : 'My Score';
  const ratingHeadingVisible = typeof showHeading === 'undefined' ? true : showHeading;
%>
<div class="rating-container" data-rating-control>
  <% if (ratingHeadingVisible) { %>
    <h3 class="title is-5 has-text-weight-semibold mb-2" id="<%= ratingLabelId %>-heading"><%= ratingHeading %></h3>
  <% } %>
  <p id="<%= ratingLabelId %>" class="rating-label mb-3">Select a score from 1 to 10</p>
  <div class="rating-display mb-3">
    <div
      id="<%= ratingBadgeId %>"
      class="rating-badge"
      aria-live="polite"
      aria-atomic="true"
    ><%= currentRating > 0 ? currentRating : '–' %></div>
  </div>
  <div
    class="rating-steps"
    role="radiogroup"
    aria-labelledby="<%= ratingHeadingVisible ? ratingLabelId + '-heading' : ratingLabelId %>"
    aria-describedby="<%= ratingLabelId %>"
  >
    <% for (let i = 1; i <= 10; i++) { %>
      <button
        type="button"
        class="rating-step"
        data-score="<%= i %>"
        role="radio"
        aria-checked="<%= currentRating === i ? 'true' : 'false' %>"
        aria-label="<%= i %> out of 10, <%= scoreLabels[i] %>"
        tabindex="<%= currentRating === i || (currentRating === 0 && i === 1) ? '0' : '-1' %>"
      >
        <span aria-hidden="true"><%= i %></span>
      </button>
    <% } %>
  </div>
  <input type="hidden" name="rating" id="<%= ratingInputId %>" value="<%= currentRating || 0 %>" />
</div>

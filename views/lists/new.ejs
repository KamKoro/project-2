<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Create List</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <main id="main-content" class="container mt-6">
    <section class="box" style="max-width: 500px; margin: 0 auto;">
      <h1 class="title is-3">Create a List</h1>
      <form action="/lists" method="POST">
        <div class="field">
          <label class="label" for="name">Name</label>
          <input class="input" id="name" name="name" required />
        </div>
        <div class="field">
          <label class="label" for="description">Description</label>
          <textarea class="textarea" id="description" name="description" rows="3"></textarea>
        </div>
        <div class="field">
          <label class="checkbox">
            <input type="checkbox" name="isPublic" checked /> Public list
          </label>
        </div>
        <button class="button is-primary" type="submit">Create</button>
      </form>
    </section>
  </main>
</body>
</html>

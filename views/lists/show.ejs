<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= list.name %></title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <main id="main-content" class="container mt-6">
    <h1 class="title is-2"><%= list.name %></h1>
    <% if (list.description) { %><p><%= list.description %></p><% } %>
    <p class="has-text-grey mb-5"><%= list.films.length %> films</p>

    <% if (!list.films.length) { %>
      <div class="box">
        <p>No films in this list yet. Add films from their detail pages.</p>
      </div>
    <% } else { %>
      <div class="movie-grid">
        <% list.films.forEach(film => { if (!film) return; %>
          <div class="movie-card">
            <a href="/films/<%= film._id %>">
              <%- include('../partials/_moviePoster', { film, className: 'movie-card-poster', alt: film.title }) %>
            </a>
            <div class="movie-card-info">
              <p class="title is-5"><a href="/films/<%= film._id %>"><%= film.title %></a></p>
              <% if (isOwner) { %>
                <form action="/lists/<%= list._id %>/films/<%= film._id %>?_method=DELETE" method="POST">
                  <button class="button is-small is-light" type="submit">Remove</button>
                </form>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <% if (isOwner) { %>
      <p class="mt-4 has-text-grey is-size-7">To add films, visit a film page and use "Add to List" from your lists page workflow, or browse <a href="/films">Discover</a>.</p>
    <% } %>
  </main>
</body>
</html>

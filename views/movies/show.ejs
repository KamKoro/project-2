<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= movie.title %> - Details</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <main id="main-content" class="container mt-5">
    <div class="movie-detail-wrapper">
      <%
        const ratingLabels = {
          1: 'Awful',
          2: 'Bad',
          3: 'Poor',
          4: 'Watchable',
          5: 'Okay',
          6: 'Good',
          7: 'Very Good',
          8: 'Great',
          9: 'Excellent',
          10: 'Masterpiece'
        };

        function badgeColorClass(rating) {
          if (rating >= 8) return 'high';
          if (rating >= 5) return 'mid';
          if (rating > 0) return 'low';
          return '';
        }
      %>
      <%- include('../partials/_moviePoster', {
        title: movie.title,
        className: 'movie-poster',
        alt: `Poster for ${movie.title} directed by ${movie.director}`
      }) %>

      <div class="movie-info">
        <h1><%= movie.title %></h1>

        <p><strong>Director:</strong> <%= movie.director %></p>
        <p><strong>Release Year:</strong> <%= movie.releaseYear || movie.year %></p>
        <p><strong>Genre:</strong> <%= movie.genre?.name || movie.genre || 'N/A' %></p>
        <p><strong>Added by:</strong> <%= owner.username %></p>

        <div class="rating-container mt-4">
          <h3 class="title is-5 has-text-weight-semibold mb-2">
            <%= isOwner ? 'My Score' : owner.username + "'s Score" %>
          </h3>

          <% const ownerRatingText = ratingLabels[movie.rating] || 'No rating'; %>
          <p class="rating-label has-text-weight-semibold mb-2"><%= ownerRatingText %></p>

          <div class="rating-display mb-3">
            <div class="rating-badge <%= badgeColorClass(movie.rating) %>"><%= movie.rating || 0 %></div>
          </div>

          <div
            class="rating-steps is-static"
            role="img"
            aria-label="Rating <%= movie.rating || 0 %> out of 10, <%= ownerRatingText %>"
          >
            <% for (let i = 1; i <= 10; i++) {
                 const isActive = i <= movie.rating;
                 const stepColorClass = badgeColorClass(movie.rating);
            %>
              <span
                class="rating-step <%= isActive ? `active ${stepColorClass}` : '' %>"
                data-score="<%= i %>"
                aria-hidden="true"
              ></span>
            <% } %>
          </div>
        </div>

        <p class="mt-4">
          <strong><%= isOwner ? 'My Review' : owner.username + "'s Review" %>:</strong>
          <%= movie.review && movie.review.trim() ? movie.review : 'No review written.' %>
        </p>

        <% if (isOwner) { %>
          <div class="buttons">
            <form action="/users/<%= user._id %>/movies/<%= movie._id %>/edit" method="GET">
              <button class="button is-info" type="submit">Edit Movie</button>
            </form>

            <form action="/users/<%= user._id %>/movies/<%= movie._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this movie?');">
              <button class="button is-danger" type="submit">Delete Movie</button>
            </form>
          </div>
        <% } %>
      </div>
    </div>

    <section class="community-reviews box mt-6" aria-labelledby="community-reviews-heading">
      <h2 id="community-reviews-heading" class="title is-4 mb-4">Reviews from Other Users</h2>

      <% if (otherReviews.length === 0) { %>
        <p class="has-text-grey">No community reviews yet.</p>
      <% } else { %>
        <div class="review-list">
          <% otherReviews.forEach(review => { %>
            <%- include('../partials/_reviewCard', {
              review,
              badgeColorClass,
              ratingLabels,
              showMovieTitle: false
            }) %>
          <% }) %>
        </div>
      <% } %>
    </section>

    <% if (!isOwner) { %>
      <section class="box mt-5">
        <h2 class="title is-4 mb-4">
          <%= currentUserReview ? 'Edit Your Review' : 'Write a Review' %>
        </h2>

        <form
          action="<%= currentUserReview ? `/movies/${movie._id}/reviews/${currentUserReview._id}?_method=PUT` : `/movies/${movie._id}/reviews` %>"
          method="POST"
        >
          <%- include('../partials/_ratingControl', {
            selectedRating: currentUserReview ? currentUserReview.rating : 0,
            labelId: 'review-rating-label',
            badgeId: 'review-rating-badge',
            inputId: 'review-rating-value',
            heading: 'Your Score'
          }) %>

          <div class="field">
            <label class="label" for="review-text">Your Review</label>
            <div class="control">
              <textarea
                class="textarea"
                id="review-text"
                name="text"
                rows="4"
                placeholder="Share your thoughts on this movie..."
              ><%= currentUserReview ? currentUserReview.text : '' %></textarea>
            </div>
          </div>

          <div class="buttons">
            <button class="button is-primary" type="submit">
              <%= currentUserReview ? 'Update Review' : 'Post Review' %>
            </button>

            <% if (currentUserReview) { %>
              <button
                type="submit"
                class="button is-danger is-light"
                formaction="/movies/<%= movie._id %>/reviews/<%= currentUserReview._id %>?_method=DELETE"
                onclick="return confirm('Are you sure you want to delete your review?');"
              >
                Delete Review
              </button>
            <% } %>
          </div>
        </form>
      </section>
    <% } %>

    <a class="button is-light is-small mt-3" href="<%= isOwner ? `/users/${user._id}/movies` : '/community/movies' %>">
      <%= isOwner ? '← Back to My Movies' : '← Back to Community' %>
    </a>
  </main>
</body>
</html>

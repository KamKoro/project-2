<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Log a Film</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <main id="main-content" class="container mt-6">
    <h1 class="title is-2 has-text-centered mb-5">Log a Film</h1>

    <% if (hasTmdb) { %>
      <section class="box mb-5">
        <h2 class="title is-4">Search TMDB</h2>
        <form method="GET" action="/films/log">
          <div class="field has-addons">
            <div class="control is-expanded">
              <label class="label" for="tmdb-search">Film title</label>
              <input class="input" id="tmdb-search" type="search" name="q" value="<%= query %>" placeholder="Search for a film..." />
            </div>
            <div class="control">
              <label class="label">&nbsp;</label>
              <button class="button is-primary" type="submit">Search</button>
            </div>
          </div>
        </form>

        <% if (results.length) { %>
          <div class="tmdb-results mt-4">
            <% results.forEach(result => { %>
              <details class="box mb-3">
                <summary class="tmdb-result-summary">
                  <strong><%= result.title %></strong>
                  <% if (result.release_date) { %> (<%= result.release_date.slice(0,4) %>)<% } %>
                </summary>
                <form action="/films/log" method="POST" class="mt-3">
                  <input type="hidden" name="tmdbId" value="<%= result.id %>" />
                  <p class="has-text-grey is-size-7 mb-3"><%= result.overview || 'No overview available.' %></p>
                  <%- include('../partials/_ratingControl', { selectedRating: 0, labelId: 'rating-' + result.id, badgeId: 'badge-' + result.id, inputId: 'input-' + result.id }) %>
                  <div class="field">
                    <label class="label" for="watched-<%= result.id %>">Date watched</label>
                    <input class="input" type="date" id="watched-<%= result.id %>" name="watchedAt" value="<%= new Date().toISOString().slice(0,10) %>" />
                  </div>
                  <div class="field">
                    <label class="label" for="text-<%= result.id %>">Review</label>
                    <textarea class="textarea" id="text-<%= result.id %>" name="text" rows="3" placeholder="Optional review"></textarea>
                  </div>
                  <button class="button is-primary" type="submit">Log & Review</button>
                </form>
              </details>
            <% }) %>
          </div>
        <% } else if (query) { %>
          <p class="has-text-grey mt-3">No TMDB results for "<%= query %>".</p>
        <% } %>
      </section>
    <% } else { %>
      <div class="notification is-warning">
        Add <code>TMDB_API_KEY</code> to your <code>.env</code> for film search. You can still log manually below.
      </div>
    <% } %>

    <section class="box">
      <h2 class="title is-4">Log manually</h2>
      <form action="/films/log" method="POST">
        <div class="field">
          <label class="label" for="title">Title</label>
          <input class="input" id="title" name="title" required />
        </div>
        <div class="field">
          <label class="label" for="director">Director</label>
          <input class="input" id="director" name="director" />
        </div>
        <div class="field">
          <label class="label" for="releaseYear">Release year</label>
          <input class="input" type="number" id="releaseYear" name="releaseYear" min="1888" required />
        </div>
        <div class="field">
          <label class="label" for="genre">Genre</label>
          <input class="input" id="genre" name="genre" />
        </div>
        <div class="field">
          <label class="label" for="watchedAt-manual">Date watched</label>
          <input class="input" type="date" id="watchedAt-manual" name="watchedAt" value="<%= new Date().toISOString().slice(0,10) %>" />
        </div>
        <%- include('../partials/_ratingControl', { selectedRating: 0 }) %>
        <div class="field">
          <label class="label" for="text-manual">Review</label>
          <textarea class="textarea" id="text-manual" name="text" rows="4"></textarea>
        </div>
        <button class="button is-primary" type="submit">Log Film</button>
      </form>
    </section>
  </main>
</body>
</html>

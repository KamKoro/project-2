<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= person.name %> — Director</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <main id="main-content" class="container mt-6">
    <a href="/directors" class="button is-light is-small mb-4">← All directors</a>

    <section class="box mb-6">
      <h1 class="title is-2"><%= person.name %></h1>
      <p class="subtitle is-5 has-text-grey">Director</p>
      <p><%= person.bio %></p>
    </section>

    <% if (communityFilms.length) { %>
      <section class="mb-6" aria-labelledby="community-films-heading">
        <h2 id="community-films-heading" class="title is-4 mb-4">In the community catalog</h2>
        <div class="movie-grid">
          <% communityFilms.forEach(film => {
              const stats = statsMap[film._id.toString()] || { count: 0, average: 0 };
          %>
            <div class="movie-card">
              <a href="/films/<%= film._id %>">
                <%- include('../partials/_moviePoster', { film, className: 'movie-card-poster', alt: film.title + ' poster' }) %>
              </a>
              <div class="movie-card-info">
                <p class="title is-6"><a href="/films/<%= film._id %>"><%= film.title %></a></p>
                <p class="has-text-grey"><%= film.releaseYear || 'N/A' %> · <%= film.genre || 'N/A' %></p>
                <% if (stats.count) { %>
                  <p class="has-text-grey">★ <%= stats.average %> · <%= stats.count %> review<%= stats.count === 1 ? '' : 's' %></p>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

    <section aria-labelledby="catalog-films-heading">
      <h2 id="catalog-films-heading" class="title is-4 mb-4">Available to log</h2>
      <% if (!catalogFilms.length) { %>
        <p class="has-text-grey">No catalog films listed for this director yet.</p>
      <% } else { %>
        <div class="local-film-list">
          <% catalogFilms.forEach(film => { %>
            <article class="box mb-3">
              <h3 class="title is-5"><%= film.title %> <span class="has-text-grey">(<%= film.releaseYear %>)</span></h3>
              <p class="has-text-grey is-size-7 mb-3"><%= film.overview %></p>
              <a href="/films/log?film=<%= film.id %>" class="button is-primary is-small">Log this film</a>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>

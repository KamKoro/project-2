<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Following Feed</title>
  <%- include('../partials/_headAssets') %>
</head>
<body>
  <%- include('../partials/_navbar') %>

  <main id="main-content" class="container mt-6">
    <h1 class="title is-2 has-text-centered mb-5">Following Feed</h1>

    <% if (!feed.length) { %>
      <div class="box has-text-centered">
        <p>Follow other users to see their reviews here. Browse <a href="/films">films</a> and visit profiles to follow people.</p>
      </div>
    <% } else { %>
      <div class="review-list">
        <% feed.forEach(review => { %>
          <%- include('../partials/_reviewCard', { review, badgeColorClass, ratingLabels }) %>
        <% }) %>
      </div>
    <% } %>
  </main>
</body>
</html>

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Scene It</title>
    <%- include('partials/_headAssets') %>
  </head>
  <body>
    <%- include('partials/_navbar') %>

    <main id="main-content" class="container mt-6">
      <% if (user) { %>
        <h1 class="has-text-centered mb-5">Welcome, <%= user.username %></h1>

        <section class="movie-stats box mb-6" aria-labelledby="stats-heading">
          <h2 id="stats-heading" class="title is-4">Your Stats</h2>
          <ul>
            <li><strong>Films watched:</strong> <%= stats.reviewCount %></li>
            <li><strong>This year:</strong> <%= stats.filmsThisYear %></li>
            <li><strong>Average rating:</strong> ★ <%= stats.avgRating %></li>
            <% if (stats.favoriteGenre) { %>
              <li><strong>Favorite genre:</strong> <%= stats.favoriteGenre %></li>
            <% } %>
            <li><strong>Watchlist:</strong> <%= watchlistCount %> film<%= watchlistCount === 1 ? '' : 's' %></li>
          </ul>
          <div class="buttons mt-3">
            <a href="/films/log" class="button is-primary is-small">Log a Film</a>
            <a href="/diary" class="button is-light is-small">View Diary</a>
          </div>
        </section>

        <% if (feed && feed.length) { %>
          <section class="box mb-6" aria-labelledby="feed-heading">
            <h2 id="feed-heading" class="title is-4">Following Feed</h2>
            <div class="review-list">
              <% feed.slice(0, 3).forEach(review => { %>
                <%- include('partials/_reviewCard', { review, badgeColorClass, ratingLabels }) %>
              <% }) %>
            </div>
            <a href="/feed" class="button is-light is-small mt-3">View full feed</a>
          </section>
        <% } %>

        <% if (reviews && reviews.length) { %>
          <section class="recent-movies box mb-6" aria-labelledby="recent-heading">
            <h2 id="recent-heading" class="title is-4">Recently Watched</h2>
            <ul>
              <% reviews.slice(0, 5).forEach(r => { %>
                <li>
                  <a href="/films/<%= r.film._id %>"><%= r.film.title %></a>
                  — ★ <%= r.rating %>/10
                </li>
              <% }) %>
            </ul>
          </section>
        <% } %>

        <% if (movieCount === 0) { %>
          <section class="add-movie-prompt box mb-6" aria-labelledby="add-first-heading">
            <h2 id="add-first-heading" class="title is-4 has-text-centered">Log Your First Film</h2>
            <p class="has-text-centered">Search TMDB or log manually to start your diary.</p>
            <div class="has-text-centered">
              <a href="/films/log" class="button is-primary is-large">Log a Film</a>
            </div>
          </section>
        <% } %>

      <% } else { %>
        <section class="hero is-light is-bold mb-6">
          <div class="hero-body">
            <div class="container has-text-centered">
              <h1 class="title is-2 mb-4">Welcome to Scene It</h1>
              <p class="subtitle is-5 mb-5">Track, rate, and review films — like Letterboxd for your collection.</p>
              <a href="/auth/sign-in" class="button is-primary is-medium">Sign in to get started</a>
            </div>
          </div>
        </section>
      <% } %>

      <% if (trending && trending.length) { %>
        <section class="box mb-6" aria-labelledby="trending-heading">
          <h2 id="trending-heading" class="title is-4">Trending Films</h2>
          <div class="movie-grid">
            <% trending.forEach(({ film, average, count }) => { %>
              <div class="movie-card">
                <a href="/films/<%= film._id %>">
                  <%- include('partials/_moviePoster', { film, className: 'movie-card-poster', alt: film.title }) %>
                </a>
                <p class="title is-6"><a href="/films/<%= film._id %>"><%= film.title %></a></p>
                <p class="has-text-grey is-size-7">★ <%= average %> (<%= count %>)</p>
              </div>
            <% }) %>
          </div>
          <a href="/films" class="button is-light is-small mt-3">Discover more</a>
        </section>
      <% } %>

      <section class="community-reviews box mb-6" aria-labelledby="latest-reviews-heading">
        <h2 id="latest-reviews-heading" class="title is-4">Latest Reviews</h2>
        <% const latestReviewItems = Array.isArray(latestReviews) ? latestReviews : []; %>
        <% if (!latestReviewItems.length) { %>
          <p class="has-text-grey">No community reviews yet.</p>
          <% if (user) { %><a href="/films" class="button is-light is-small mt-3">Discover Films</a><% } %>
        <% } else { %>
          <div class="review-list">
            <% latestReviewItems.forEach(review => { %>
              <%- include('partials/_reviewCard', { review, badgeColorClass, ratingLabels }) %>
            <% }) %>
          </div>
        <% } %>
      </section>
    </main>
  </body>
</html>
